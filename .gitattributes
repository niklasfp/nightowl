# Normalize line endings to LF everywhere so dotnet format (eol=lf) is consistent
# across Windows/macOS/Linux checkouts. Git auto-detects and leaves binaries alone.
* text=auto eol=lf

# Explicit: source and config files are text with LF endings.
*.cs    text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# Shell scripts must keep LF; Windows scripts keep CRLF.
*.cmd   text eol=crlf
*.bat   text eol=crlf
